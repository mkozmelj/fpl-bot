# Copy to .env (gitignored) and fill in. Placeholders only: never commit real values.
# Production values live in Railway sealed variables, never in this repo or in CI.
# The bot reads the process environment, so load the file first:
#   set -a; . ./.env; set +a

# --- Required -------------------------------------------------------------------------------
# From @BotFather. Use your own bot; never the owner's.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# The docker-compose Postgres (docker compose up -d). In production: Neon's pooled URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fplbot
# Your numeric Telegram user ID: the only chat that may /invite.
OWNER_TELEGRAM_ID=000000000

# --- Optional -------------------------------------------------------------------------------
# "live" calls the official FPL API; "fake" serves the synthetic fixtures in core/tests/fixtures/fpl.
FPL_SOURCE=fake
# Another fixture directory for FPL_SOURCE=fake.
# FPL_FIXTURES_DIR=
# Pinged every 5 minutes while the bot is healthy (your own uptime monitor). Unset: no pings.
# HEARTBEAT_URL=
# Claude explanations (not used in Phase 1). Unset: templated text only.
# ANTHROPIC_API_KEY=

# --- Tests ----------------------------------------------------------------------------------
# Admin URL of a throwaway Postgres server; each test session creates and drops its own database.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
